DATABASE_URL="postgresql://gestion_dev:YOUR_DEVELOPMENT_PASSWORD@127.0.0.1:5432/gestion_dev?schema=public"
PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
# Días sin uso hasta que vence la sesión (SISTEMA-93). Por defecto 7. La API no
# arranca con menos de 3 (72 h): siempre sobra margen sobre las 24 h sin internet.
# SESSION_INACTIVITY_DAYS=7
# Desarrollo: vista previa local del catálogo separado. Producción requiere
# EXTERNAL_CATALOG_ENABLED=true y una URL local independiente configurada en el VPS.
EXTERNAL_CATALOG_PREVIEW=false
EXTERNAL_CATALOG_ORGANIZATION_ID=""
EXTERNAL_CATALOG_DATABASE_URL=""
SEED_OWNER_EMAIL=owner@demo.local
SEED_OWNER_PASSWORD="replace-with-a-development-password-of-at-least-12-characters"
