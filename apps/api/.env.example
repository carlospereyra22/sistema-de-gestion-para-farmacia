DATABASE_URL="postgresql://gestion_dev:YOUR_DEVELOPMENT_PASSWORD@127.0.0.1:5432/gestion_dev?schema=public"
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Sitio del catálogo online (SISTEMA-107). Sólo puede llamar a /api/v1/catalogo/...
CATALOGO_ORIGIN=http://localhost:5175
JWT_ACCESS_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
# Días sin uso hasta que vence la sesión (SISTEMA-93). Por defecto 7. La API no
# arranca con menos de 3 (72 h): siempre sobra margen sobre las 24 h sin internet.
# SESSION_INACTIVITY_DAYS=7
# Tope de conexiones a PostgreSQL de este proceso y segundos de espera por una
# libre (SISTEMA-106). En el servidor los fija el compose por rol; en desarrollo
# no hacen falta. Ver docs/DOCKER.md.
# DATABASE_CONNECTION_LIMIT=10
# DATABASE_POOL_TIMEOUT=20
# Tareas programadas: "off" las apaga en este proceso. En el servidor corren
# sólo en el worker (apps/api/src/worker.ts).
# PRICE_REFRESH_SCHEDULER=off
# FISCAL_QUEUE_WORKER=off
# SUBSCRIPTION_SCHEDULER=off
# CATALOG_APORTES_SCHEDULER=off
# MEDICINE_PHOTOS_SCHEDULER=off
# Desarrollo: vista previa local del catálogo separado. Producción requiere
# EXTERNAL_CATALOG_ENABLED=true y una URL local independiente configurada en el VPS.
EXTERNAL_CATALOG_PREVIEW=false
EXTERNAL_CATALOG_ORGANIZATION_ID=""
EXTERNAL_CATALOG_DATABASE_URL=""
# Aportes de las farmacias al catálogo externo (SISTEMA-112). El ambiente separa
# producción, test y la PC (comparten la base del catálogo). La URL es la del rol
# que sólo escribe en aporte_farmacia; la usa el worker. Sin ambas, apagado.
CATALOG_APORTES_AMBIENTE=""
CATALOG_APORTES_DATABASE_URL=""
SEED_OWNER_EMAIL=owner@demo.local
SEED_OWNER_PASSWORD="replace-with-a-development-password-of-at-least-12-characters"
