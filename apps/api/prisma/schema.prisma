}

model CashMovement {
  id String @id @default(uuid()) @db.Uuid
  cashSessionId String @db.Uuid
  type CashMovementType
  amountMinor BigInt
  reason String
  actorId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  @@index([cashSessionId, createdAt])
}

model Sale {
  offers SaleOffer[]
  offlineSyncIssues OfflineSyncIssue[]
  fiscalDocuments FiscalDocument[]
  documentType String @default("INTERNAL") @db.VarChar(20)
  fiscalTrial FiscalTrial?
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  branchId String @db.Uuid
  customerId String? @db.Uuid
  clientOperationId String? @db.Uuid
  status SaleStatus @default(DRAFT)
  totalMinor BigInt @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  accountDueDate DateTime? @db.Date
  items SaleItem[]
  payments SalePayment[]
  customerReturns CustomerReturn[]
  accountMovements CustomerAccountMovement[]
  @@index([organizationId, branchId, createdAt])
  @@unique([id, organizationId])
  @@unique([organizationId, clientOperationId])
}

model FiscalProductionConfiguration {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  branchId String @unique @db.Uuid
  point Int
  issuerCuit String @db.VarChar(11)
  credentialVersion Int
  enabled Boolean @default(false)
  exclusiveConfirmed Boolean @default(false)
  activatedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  @@unique([organizationId, point])
  @@unique([issuerCuit, point])
  @@unique([branchId, organizationId])
}

model FiscalDocument {
  settlement Json?
  settledAt DateTime? @db.Timestamptz(6)
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  branchId String @db.Uuid
  sourceSaleId String @db.Uuid
  requestId String @db.Uuid
  environment String @default("PRODUCTION") @db.VarChar(20)
  kind String @db.VarChar(20)
  originalId String? @db.Uuid
  status String @default("QUEUED") @db.VarChar(20)
  issuerCuit String @db.VarChar(11)
  point Int
  voucherType Int
  number Int?
  date String @db.VarChar(8)
  totalMinor Int
  docType Int
  docNumber String @db.VarChar(11)
  recipientVatId Int
  issuer Json
  saleSnapshot Json
  reason String?
  cae String?
  caeExpires String?
  detail String?
  /// Por qué se facturó después de la venta: CAJA_CERRADA o COMPROBANTE_INTERNO (SISTEMA-65).
  deferredReason String? @db.VarChar(20)
  /// Cuándo una factura en espera (HELD) pasó a la cola al incorporar el cobro.
  releasedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sourceSale Sale @relation(fields: [sourceSaleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  original FiscalDocument? @relation("CreditOriginal", fields: [originalId, organizationId], references: [id, organizationId], onDelete: Restrict)
  credits FiscalDocument[] @relation("CreditOriginal")
  @@unique([id, organizationId])
  @@unique([organizationId, requestId])
  @@index([organizationId, status])
  @@index([sourceSaleId])
  @@index([originalId])
}

// Modo sin internet (SISTEMA-63): operación que una PC hizo sin conexión y
// sincronizó después. El id es el clientOperationId que generó la PC: hace
// idempotente el reenvío. requestHash detecta el mismo id con otro contenido.
model OfflineOperation {
  id String @id @db.Uuid
  organizationId String @db.Uuid
  branchId String @db.Uuid
  kind String @db.VarChar(30)
  actorId String @db.Uuid
  deviceId String @db.Uuid
  occurredAt DateTime @db.Timestamptz(6)
  receivedAt DateTime @default(now()) @db.Timestamptz(6)
  requestHash String @db.VarChar(64)
  entityId String? @db.Uuid
  branch Branch @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  issues OfflineSyncIssue[]
  @@unique([id, organizationId])
  @@index([organizationId, branchId, receivedAt])
}

// Aviso "a revisar" de una operación sincronizada: se registró igual, pero
// algo había cambiado mientras no había conexión (precio, stock, caja...).
model OfflineSyncIssue {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  branchId String @db.Uuid
  operationId String @db.Uuid
  saleId String? @db.Uuid
  kind String @db.VarChar(40)
  status String @default("OPEN") @db.VarChar(20)
  detail Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  resolvedAt DateTime? @db.Timestamptz(6)
  resolvedById String? @db.Uuid
  resolutionNote String?
  branch Branch @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  operation OfflineOperation @relation(fields: [operationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sale Sale? @relation(fields: [saleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  @@index([organizationId, branchId, status, createdAt])
  @@index([saleId])
}

model SaleItem {
  id String @id @default(uuid()) @db.Uuid
  saleId String @db.Uuid
  productId String? @db.Uuid
  description String?
  lotId String? @db.Uuid
  quantity Int
  unitPriceMinor BigInt
  discountMinor BigInt @default(0)
  /// Parte de discountMinor que viene de ofertas (SISTEMA-103). discountMinor sigue siendo el total.
  offerDiscountMinor BigInt @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customerReturnItems CustomerReturnItem[]
  @@index([saleId])
  @@index([productId])
}

model CustomerReturn {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  branchId String @db.Uuid
  saleId String @db.Uuid
  actorId String @db.Uuid
  reason String
  status CustomerReturnStatus @default(RECEIVED_NOT_RESTOCKED)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  items CustomerReturnItem[]
  @@index([organizationId, branchId, createdAt])
  @@index([saleId])
}

model CustomerReturnItem {
  id String @id @default(uuid()) @db.Uuid
  customerReturnId String @db.Uuid
  saleItemId String @db.Uuid
  quantity Int
  customerReturn CustomerReturn @relation(fields: [customerReturnId], references: [id], onDelete: Restrict)
  saleItem SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  @@index([customerReturnId])
  @@index([saleItemId])
}

model SupplierReturn {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  branchId String @db.Uuid
  // Null: stock sin proveedor conocido (SISTEMA-36).
  supplierId String? @db.Uuid
  lotId String @db.Uuid
  productId String @db.Uuid
  quantity Int
  reason String
  actorId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([organizationId, branchId, createdAt])
  @@index([supplierId])
  @@index([lotId])
}

model SalePayment {
  id String @id @default(uuid()) @db.Uuid
  saleId String @db.Uuid
  method PaymentMethod
  amountMinor BigInt
  cashSessionId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  @@index([saleId])
  @@index([cashSessionId])
}

// Certificado de Farmatec para consultar el padrón de ARCA (constancia de
// inscripción) en nombre de la plataforma, para todas las farmacias. Uno por
// ambiente. La clave privada y el acceso de ARCA van cifrados (SISTEMA-70).
model PlatformPadronCredential {
  id                  String    @id @default(uuid()) @db.Uuid
  environment         String    @unique @db.VarChar(20)
  cuit                String    @db.VarChar(11)
  encryptedPrivateKey String
  csr                 String?
  certificate         String?
  fingerprint         String?
  expiresAt           DateTime? @db.Timestamptz(6)
  encryptedTicket     String?
  ticketExpiresAt     DateTime? @db.Timestamptz(6)
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)
}

// Ofertas (SISTEMA-103): promociones de la organización que la venta aplica
// sola. El estado vigente (programada, activa, vencida) se calcula con la
// fecha y la hora: no se guarda. Los parámetros van en columnas tipadas, con un
// CHECK por tipo; un tipo nuevo es una columna más, sin JSON.
enum OfferType {
  PERCENT
  AMOUNT_OFF
  FIXED_PRICE
  BUY_X_PAY_Y
  NTH_UNIT_PERCENT
  TIERED
  BUNDLE
}

enum OfferStatus {
  DRAFT
  PUBLISHED
  PAUSED
  FINISHED
  ARCHIVED
}

enum OfferProductKind {
  ALL
  MEDICATION
  NON_MEDICATION
}

enum OfferTargetKind {
  PRODUCT
  CATEGORY
  LABORATORY
}

model Offer {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  name String @db.VarChar(120)
  type OfferType
  status OfferStatus @default(DRAFT)
  priority Int @default(0)
  combinable Boolean @default(false)
  startsAt DateTime @db.Timestamptz(6)
  endsAt DateTime? @db.Timestamptz(6)
  /// Días de la semana en Argentina: bit 0 = domingo ... bit 6 = sábado. Nulo = todos.
  weekdays Int?
  /// Franja horaria en minutos desde las 00:00 de Argentina. Ambos o ninguno.
  dayStartMinute Int?
  dayEndMinute Int?
  allBranches Boolean @default(true)
  allPriceLists Boolean @default(true)
  productKind OfferProductKind @default(ALL)
  maxUnitsPerSale Int?
  maxUnitsTotal Int?
  percentBps Int?
  amountMinor BigInt?
  fixedPriceMinor BigInt?
  buyQuantity Int?
  payQuantity Int?
  nthUnit Int?
  bundlePriceMinor BigInt?
  version Int @default(1)
  createdById String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  pausedAt DateTime? @db.Timestamptz(6)
  finishedAt DateTime? @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)
  targets OfferTarget[]
  tiers OfferTier[]
  branches OfferBranch[]
  priceLists OfferPriceList[]
  sales SaleOffer[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
}

model OfferTier {
  id String @id @default(uuid()) @db.Uuid
  offerId String @db.Uuid
  organizationId String @db.Uuid
  minQuantity Int
  percentBps Int?
  amountMinor BigInt?
  offer Offer @relation(fields: [offerId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([offerId, minQuantity])
}

model OfferTarget {
  id String @id @default(uuid()) @db.Uuid
  offerId String @db.Uuid
  organizationId String @db.Uuid
  kind OfferTargetKind
  productId String? @db.Uuid
  categoryId String? @db.Uuid
  laboratoryId String? @db.Uuid
  /// Exclusión: no entra aunque esté en la categoría o el laboratorio.
  exclude Boolean @default(false)
  /// Unidades del producto en el combo (sólo BUNDLE).
  quantity Int?
  offer Offer @relation(fields: [offerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  product Product? @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)
  category Category? @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  laboratory Laboratory? @relation(fields: [laboratoryId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([offerId])
  @@index([productId])
  @@index([categoryId])
  @@index([laboratoryId])
}

model OfferBranch {
  offerId String @db.Uuid
  branchId String @db.Uuid
  organizationId String @db.Uuid
  offer Offer @relation(fields: [offerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  branch Branch @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([offerId, branchId])
  @@index([branchId])
}

model OfferPriceList {
  offerId String @db.Uuid
  priceListId String @db.Uuid
  organizationId String @db.Uuid
  offer Offer @relation(fields: [offerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  priceList PriceList @relation(fields: [priceListId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([offerId, priceListId])
  @@index([priceListId])
}

/// Instantánea de una oferta aplicada en una venta: nombre, tipo, parámetros y
/// descuento. Un cambio posterior de la oferta no la altera.
model SaleOffer {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  saleId String @db.Uuid
  offerId String @db.Uuid
  offerVersion Int
  name String @db.VarChar(120)
  label String @db.VarChar(60)
  type OfferType
  /// Parámetros de la oferta al vender, escritos por el servidor desde las columnas tipadas.
  parameters Json
  units Int
  discountMinor BigInt
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  sale Sale @relation(fields: [saleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  offer Offer @relation(fields: [offerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  items SaleOfferItem[]

  @@index([organizationId, offerId, createdAt])
  @@index([saleId])
}

model SaleOfferItem {
  id String @id @default(uuid()) @db.Uuid
  saleOfferId String @db.Uuid
  productId String @db.Uuid
  units Int
  /// Importe de lista de esas unidades, antes de la oferta.
  grossMinor BigInt
  discountMinor BigInt
  saleOffer SaleOffer @relation(fields: [saleOfferId], references: [id], onDelete: Restrict)

  @@index([saleOfferId])
  @@index([productId])
}
