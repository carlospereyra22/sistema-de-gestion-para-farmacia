generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PrintJobStatus {
  PENDING
  LEASED
  PRINTED
  FAILED
  CANCELLED
}

model PrintGateway {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  branchId String @db.Uuid
  name String @db.VarChar(120)
  secretHash String @db.VarChar(64)
  enabled Boolean @default(true)
  lastSeenAt DateTime? @db.Timestamptz(6)
  version String? @db.VarChar(40)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  printers Printer[]
  @@unique([id, organizationId, branchId])
  @@index([organizationId, branchId])
}

model Printer {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  branchId String @db.Uuid
  gatewayId String @db.Uuid
  name String @db.VarChar(120)
  windowsPrinterName String @db.VarChar(200)
  transport String @default("windowsRaw")
  profileVersion String @default("V21_FINAL_DENSITY_4")
  enabled Boolean @default(true)
  isDefault Boolean @default(false)
  cashRegisterId String? @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  gateway PrintGateway @relation(fields: [gatewayId, organizationId, branchId], references: [id, organizationId, branchId], onDelete: Restrict)
  jobs PrintJob[]
  @@unique([id, organizationId, branchId, gatewayId])
  @@index([organizationId, branchId])
}

model PrintJob {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  branchId String @db.Uuid
  printerId String @db.Uuid
  gatewayId String @db.Uuid
  requestId String @db.Uuid
  documentType String @db.VarChar(20)
  documentId String @db.Uuid
  requestedByUserId String @db.Uuid
  reprintOfId String? @db.Uuid
  profileVersion String
  rawPayload Bytes
  payloadHash String @db.VarChar(64)
  status PrintJobStatus @default(PENDING)
  attempts Int @default(0)
  leaseId String? @db.Uuid
  leaseUntil DateTime? @db.Timestamptz(6)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(6)
  lastError String? @db.VarChar(300)
  uncertain Boolean @default(false)
  printedAt DateTime? @db.Timestamptz(6)
  failedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  printer Printer @relation(fields: [printerId, organizationId, branchId, gatewayId], references: [id, organizationId, branchId, gatewayId], onDelete: Restrict)
  @@unique([organizationId, requestId])
  @@index([gatewayId, status, createdAt])
  @@index([organizationId, branchId, documentType, documentId])
}

model Organization {
  productionConfigurations FiscalProductionConfiguration[]
  fiscalDocuments FiscalDocument[]
  fiscalTrials FiscalTrial[]
  fiscalCredentials FiscalCredential[]
  fiscalPoints FiscalPoint[]
  fiscalProfile   Json?
  ticketHeader    Json?
  // Comprobante A4 (SISTEMA-17): logo a color JPEG y opciones de la plantilla.
  documentLogo          Bytes?
  documentLogoUpdatedAt DateTime? @db.Timestamptz(6)
  documentTemplate      Json?
  id              String             @id @default(uuid()) @db.Uuid
  name            String
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)
  branches        Branch[]
  userMemberships UserOrganization[]
  roles           Role[]
  categories      Category[]
  laboratories    Laboratory[]
  products        Product[]
  priceLists      PriceList[]
  auditLogs       AuditLog[]
  subscription    OrganizationSubscription?
  subscriptionCharges  SubscriptionCharge[]
  subscriptionPayments SubscriptionPayment[]
}

model FiscalCredential {
  encryptedTicket String?
  ticketExpiresAt DateTime? @db.Timestamptz(6)
  // Acceso aparte para el padrón de ARCA (constancia de inscripción): ARCA da
  // uno por servicio y no lo repite hasta que vence (SISTEMA-70).
  encryptedPadronTicket String?
  padronTicketExpiresAt DateTime? @db.Timestamptz(6)
  verifiedAt DateTime? @db.Timestamptz(6)
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  environment String @default("HOMOLOGATION") @db.VarChar(20)
  representedCuit String @db.VarChar(11)
  holderCuit String @db.VarChar(11)
  version Int @default(1)
  encryptedPrivateKey String
  csr String?
  certificate String?
  fingerprint String?
  expiresAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@unique([organizationId, environment])
}

model FiscalTrial {
  sourceSaleId String? @unique @db.Uuid
  @@unique([sourceSaleId, organizationId])
  sourceSale Sale? @relation(fields: [sourceSaleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  saleSnapshot Json?
  docType Int @default(99)
  docNumber String @default("0") @db.VarChar(11)
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  requestId String @db.Uuid
  environment String @default("HOMOLOGATION") @db.VarChar(20)
  point Int
  voucherType Int
  number Int?
  date String @db.VarChar(8)
  totalMinor Int
  issuer Json
  status String @default("PENDING") @db.VarChar(20)
  cae String?
  caeExpires String?
  detail String?
  /// Por qué se facturó después de la venta: CAJA_CERRADA o COMPROBANTE_INTERNO (SISTEMA-65).
  deferredReason String? @db.VarChar(20)
  /// Cuándo una factura en espera (HELD) pasó a la cola al incorporar el cobro.
  releasedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@unique([organizationId, requestId])
  @@index([organizationId, status])
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  branchId String? @db.Uuid
  actorId String? @db.Uuid
  entityType String
  entityId String? @db.Uuid
  action String
  before Json?
  after Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

model Category {
  matchingTerms  String[]     @default([])
  matchingEnabled Boolean    @default(false)
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  icon           String       @default("auto")
  color          String       @default("auto")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products       Product[]
  parentId       String?      @db.Uuid
  parent         Category?    @relation("CategoryTree", fields: [parentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction)
  children       Category[]   @relation("CategoryTree")
  offerTargets   OfferTarget[]

  @@unique([id, organizationId])
  @@index([organizationId, parentId])
}

model Laboratory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  logo           Bytes?
  logoUpdatedAt  DateTime?    @db.Timestamptz(6)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products       Product[]
  offerTargets   OfferTarget[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
}

model Product {
  brand          String?         @db.VarChar(120)
  isMedication   Boolean         @default(false)
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  categoryId     String?         @db.Uuid
  laboratoryId   String?         @db.Uuid
  name           String
  description    String?
  activeIngredient String?
  pharmaceuticalForm String?
  concentration  String?
  presentation   String?
  externalReferenceSource String?
  externalReferenceName String?
  externalReferencePresentation String?
  externalReferenceBarcode String?
  externalReferencePriceMinor BigInt?
  priceDivisor Int?
  priceMarkupBps Int @default(0)
  priceBaseMinor BigInt?
  // Abrir cajas (SISTEMA-103): esta caja se abre en `splitFactor` unidades del
  // producto `splitTargetProductId` (ej. x100 -> 10 blísteres x10).
  splitTargetProductId String? @db.Uuid
  splitFactor Int?
  // Precio editado a mano en un medicamento vinculado (SISTEMA-103): la
  // actualización automática ya no cambia su precio de venta.
  priceManual Boolean @default(false)
  externalReferenceUpdatedAt DateTime? @db.Timestamptz(6)
  externalReferenceCheckedAt DateTime? @db.Timestamptz(6)
  saleUnit       SaleUnit        @default(BOX)
  prescriptionRequired Boolean @default(false)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  laboratory     Laboratory?     @relation(fields: [laboratoryId], references: [id], onDelete: Restrict)
  barcodes       ProductBarcode[]
  prices         ProductPrice[]
  image          ProductImage?
  branchStates   ProductBranchState[]
  splitTarget    Product?        @relation("ProductSplit", fields: [splitTargetProductId, organizationId], references: [id, organizationId], onDelete: Restrict)
  splitSources   Product[]       @relation("ProductSplit")
  offerTargets   OfferTarget[]

  @@unique([id, organizationId])
  @@index([organizationId, name])
  @@index([externalReferenceSource])
}

model ProductBranchState {
  organizationId String @db.Uuid
  branchId String @db.Uuid
  productId String @db.Uuid
  status String
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  @@id([branchId, productId])
  @@index([organizationId, branchId, status])
}

// Tipo de código (SISTEMA-20): el del envase, el interno SG para etiquetas o
// el EAN de un envase importado equivalente al medicamento nacional.
enum ProductBarcodeKind {
  PACKAGE
  INTERNAL
  EQUIVALENT
}

model ProductBarcode {
  id             String             @id @default(uuid()) @db.Uuid
  // Único por organización (SISTEMA-20): dos farmacias pueden cargar el mismo
  // código; dentro de una farmacia identifica un solo producto.
  organizationId String             @db.Uuid
  productId      String             @db.Uuid
  code           String
  primary        Boolean            @default(false)
  kind           ProductBarcodeKind @default(PACKAGE)
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  product        Product            @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, code])
  @@index([productId])
}

// Copia local de las fuentes de medicamentos (SISTEMA-21), compartida por
// todas las organizaciones: es información pública, igual para todas. El padrón
// oficial se reemplaza completo en cada descarga; Precios de Remedios y
// AlfaBeta guardan lo consultado por nombre (`lookupKey`).
model MedicineReferenceSnapshot {
  id                   String   @id @default(uuid()) @db.Uuid
  source               String   @db.VarChar(20)
  lookupKey            String   @default("")
  gtin                 String?  @db.VarChar(14)
  barcode              String   @default("")
  name                 String
  presentation         String   @default("")
  laboratory           String   @default("")
  activeIngredient     String   @default("")
  pharmaceuticalForm   String   @default("")
  concentration        String   @default("")
  troquel              String   @default("")
  saleType             String   @default("")
  prescriptionRequired Boolean?
  priceMinor           BigInt?
  pamiPriceMinor       BigInt?
  sourceUpdatedAt      String?
  // Nombre, presentación, laboratorio y droga normalizados para buscar.
  searchText           String   @default("")
  runId                String   @db.Uuid
  refreshedAt          DateTime @default(now()) @db.Timestamptz(6)

  @@index([source, gtin])
  @@index([source, lookupKey])
}

// Base propia de medicamentos (SISTEMA-26), compartida por todas las
// organizaciones: información pública, igual para todas. Solo entran productos
// con precio y link de referencia; la corrida de las 09:00 y 17:00 los actualiza.
model MedicineCatalogItem {
  id                 String                   @id @default(uuid()) @db.Uuid
  // Identificador de origen: `ab-<CLAVE>`, la CLAVE del padrón oficial.
  externalKey        String                   @unique @db.VarChar(40)
  name               String
  presentation       String                   @default("")
  activeIngredient   String                   @default("")
  laboratory         String                   @default("")
  pharmaceuticalForm String                   @default("")
  saleCondition      String                   @default("")
  troquel            String                   @default("")
  // official | preciosderemedios | alfabeta
  priceSource        String                   @db.VarChar(20)
  priceMinor         BigInt
  // Link exacto de Remedios o AlfaBeta. El padrón no admite link directo.
  referenceUrl       String?
  // Fila de la fuente que da el precio, normalizada.
  sourceRowKey       String                   @default("")
  // El padrón oficial lo dio de baja: sigue funcionando con su otra fuente.
  officialDelisted   Boolean                  @default(false)
  // Laboratorio de la base / laboratorio de la fuente, cuando difieren.
  laboratoryMismatch String?
  // Precio leído y no aplicado: queda para revisar a mano.
  reviewReason       String?
  // Nombre, presentación, laboratorio y droga normalizados para buscar.
  searchText         String                   @default("")
  priceUpdatedAt     DateTime                 @default(now()) @db.Timestamptz(6)
  priceCheckedAt     DateTime?                @db.Timestamptz(6)
  createdAt          DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(6)
  barcodes           MedicineCatalogBarcode[]

  @@index([priceSource])
  @@index([name])
}

// Un producto puede tener varios códigos. `gtin` queda vacío si el dígito de
// control es inválido: esos códigos se conservan porque el padrón los informa.
model MedicineCatalogBarcode {
  id      String              @id @default(uuid()) @db.Uuid
  itemId  String              @db.Uuid
  barcode String              @db.VarChar(32)
  gtin    String?             @db.VarChar(14)
  item    MedicineCatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, barcode])
  @@index([gtin])
  @@index([barcode])
}

// Producto sin precio ni link confiable (SISTEMA-35). Se guarda hasta conseguirlo:
// no es referencia, ninguna búsqueda ni corrida de precios lo lee. Sale de acá
// cuando entra a MedicineCatalogItem.
model MedicineCatalogPending {
  externalKey        String   @id @db.VarChar(40)
  name               String
  presentation       String   @default("")
  activeIngredient   String   @default("")
  laboratory         String   @default("")
  pharmaceuticalForm String   @default("")
  saleCondition      String   @default("")
  barcodes           String[]
  // Por qué no tiene fuente: no está en Remedios, ambiguo, laboratorio distinto.
  reason             String   @default("")
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
}

// Exhibidor de droguería: un código que equivale a N unidades de otro. No es un
// producto: en Compras suma N unidades al producto base, con el costo dividido.
model MedicineCatalogPack {
  barcode     String   @id @db.VarChar(32)
  baseBarcode String   @db.VarChar(32)
  factor      Int
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
}

// Equivalencias de laboratorio entre la base y las fuentes por nombre.
// status: igual | parecido | duda | distinto. Con duda o distinto no se aplica
// el precio de la fuente.
model MedicineLaboratoryAlias {
  catalogName String
  sourceName  String
  status      String @db.VarChar(20)

  @@id([catalogName, sourceName])
}

// Corrida de actualización de precios externos (SISTEMA-21). Una corrida
// global (sin organizationId) a la vez; las de una farmacia aplican la copia
// local sin descargar.
model PriceRefreshRun {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String?              @db.Uuid
  trigger        String               @db.VarChar(20)
  status         String               @db.VarChar(20)
  startedAt      DateTime             @default(now()) @db.Timestamptz(6)
  finishedAt     DateTime?            @db.Timestamptz(6)
  snapshotRows   Int?
  checked        Int                  @default(0)
  updated        Int                  @default(0)
  failed         Int                  @default(0)
  message        String?
  revertedAt     DateTime?            @db.Timestamptz(6)
  changes        PriceRefreshChange[]

  @@index([startedAt])
}

// Precio cambiado por una corrida: permite deshacerla sin pisar cambios
// manuales posteriores.
model PriceRefreshChange {
  id                    String          @id @default(uuid()) @db.Uuid
  runId                 String          @db.Uuid
  organizationId        String          @db.Uuid
  productId             String          @db.Uuid
  priceListId           String?         @db.Uuid
  beforeAmountMinor     BigInt?
  afterAmountMinor      BigInt?
  beforeReferenceMinor  BigInt?
  afterReferenceMinor   BigInt
  createdAt             DateTime        @default(now()) @db.Timestamptz(6)
  run                   PriceRefreshRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([runId])
  @@index([organizationId, createdAt])
}

// Ajustes de la plataforma, no de una organización (SISTEMA-21): por ejemplo,
// pausar la aplicación automática de precios externos.
model PlatformSetting {
  key       String   @id @db.VarChar(80)
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model SubscriptionPlan {
  id               String                     @id @default(uuid()) @db.Uuid
  code             String                     @unique
  name             String
  baseMinor        BigInt                     @default(0)
  extraUserMinor   BigInt                     @default(0)
  extraBranchMinor BigInt                     @default(0)
  includedUsers    Int                        @default(1)
  includedBranches Int                        @default(1)
  createdAt        DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                   @updatedAt @db.Timestamptz(6)
  subscriptions    OrganizationSubscription[]
}

model OrganizationSubscription {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @unique @db.Uuid
  planId           String           @db.Uuid
  exempt           Boolean          @default(false)
  trialEndsAt      DateTime?        @db.Date
  paidThrough      DateTime?        @db.Date
  extendedUntil    DateTime?        @db.Date
  extendedReason   String?
  suspendedAt      DateTime?        @db.Timestamptz(6)
  cancelledAt      DateTime?        @db.Timestamptz(6)
  extraUsers       Int              @default(0)
  extraBranches    Int              @default(0)
  agreedPriceMinor BigInt?
  contactName      String?
  contactPhone     String?
  contactEmail     String?
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(6)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan             SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
}

model SubscriptionCharge {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  periodStart    DateTime     @db.Date
  periodEnd      DateTime     @db.Date
  amountMinor    BigInt
  breakdown      Json
  waivedAt       DateTime?    @db.Timestamptz(6)
  waivedById     String?      @db.Uuid
  waiveReason    String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, periodStart])
}

model SubscriptionPayment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  operationId    String       @db.Uuid
  requestHash    String
  amountMinor    BigInt
  paidOn         DateTime     @db.Date
  method         String
  reference      String?
  createdById    String       @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  voidedAt       DateTime?    @db.Timestamptz(6)
  voidedById     String?      @db.Uuid
  voidReason     String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, operationId])
  @@index([organizationId, paidOn])
}

/// Acceso al panel de plataforma atado a una pestaña (SISTEMA-94). Se entrega al
/// ingresar el código; la web lo guarda sólo en memoria y lo manda en el
/// encabezado X-Plataforma. Se guarda sólo el hash del secreto.
model PlatformToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  sessionId  String    @db.Uuid
  tokenHash  String    @db.VarChar(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  lastUsedAt DateTime  @default(now()) @db.Timestamptz(6)
  /// Máximo absoluto, aunque se use todo el tiempo.
  expiresAt  DateTime  @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  userAgent  String?   @db.VarChar(160)
  ip         String?   @db.VarChar(64)
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  session    AuthSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([sessionId])
}

model PlatformAdmin {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  active          Boolean   @default(true)
  totpSecret      String?
  totpConfirmedAt DateTime? @db.Timestamptz(6)
  totpLastStep    Int?
  failedAttempts  Int       @default(0)
  lockedUntil     DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model PlatformAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String?  @db.Uuid
  action         String
  entityType     String?
  entityId       String?  @db.Uuid
  organizationId String?  @db.Uuid
  before         Json?
  after          Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
  @@index([organizationId, createdAt])
}

model ProductImage {
  productId      String   @id @db.Uuid
  organizationId String   @db.Uuid
  content        Bytes
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model PriceList {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  prices         ProductPrice[]
  customers      Customer[]
  fallbackPriceListId String? @db.Uuid
  fallbackPriceList PriceList? @relation("PriceListFallback", fields: [fallbackPriceListId], references: [id], onDelete: Restrict)
