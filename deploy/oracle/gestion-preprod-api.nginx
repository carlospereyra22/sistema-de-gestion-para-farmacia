# This is included only inside the existing HTTPS server for 163.176.241.51.
# It deliberately does not publish Swagger or any route outside /preprod/api/v1/.
# Sin compresión en las respuestas con tokens de sesión (BREACH, SISTEMA-74);
# el resto hereda el gzip del server.
location ^~ /preprod/api/v1/auth/ {
    gzip off;
    proxy_pass http://127.0.0.1:3001/api/v1/auth/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "no-store" always;
}
location ^~ /preprod/api/v1/ {
    # The trailing slash removes /preprod while preserving Nest's /api/v1 prefix.
    proxy_pass http://127.0.0.1:3001/api/v1/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "no-store" always;
}
