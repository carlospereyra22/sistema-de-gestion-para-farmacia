server {
    listen 80;
    server_name 163.176.241.51;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        return 301 https://163.176.241.51$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name 163.176.241.51;
    ssl_certificate /etc/letsencrypt/live/gestion-api-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gestion-api-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 1m;

    # Compresión de las respuestas JSON (SISTEMA-74): el catálogo de una
    # farmacia grande pesa decenas de MB sin comprimir y unas pocas comprimido.
    # Aplica también a /preprod/api/v1/, que se incluye en este mismo server.
    gzip on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types application/json text/plain;

    # Sin compresión en las respuestas con tokens de sesión (BREACH).
    location ^~ /api/v1/auth/ {
        gzip off;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
    }
    location /api/v1/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
    }
    location / {
        return 404;
    }
}
