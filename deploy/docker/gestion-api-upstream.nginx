# Dos copias de la API detrás de nginx (SISTEMA-106).
#
# Va en /etc/nginx/conf.d/gestion-api-upstream.conf (contexto http). Después,
# en el sitio existente (deploy/oracle/gestion-api.nginx), cambiar las dos
# líneas `proxy_pass http://127.0.0.1:3000;` por `proxy_pass http://gestion_api;`
# y agregar debajo de cada una la línea `proxy_next_upstream` de abajo.
# Preproducción: lo mismo con `gestion_preprod_api` en
# deploy/oracle/gestion-preprod-api.nginx (conservando la ruta: 
# `proxy_pass http://gestion_preprod_api/api/v1/;`).
#
# Revisar con `sudo nginx -t` y recargar con `sudo systemctl reload nginx`.
# Con una sola copia levantada nginx sigue atendiendo con la otra: por eso el
# reinicio de a una no corta el servicio.

upstream gestion_api {
    server 127.0.0.1:3000 max_fails=2 fail_timeout=10s;
    server 127.0.0.1:3002 max_fails=2 fail_timeout=10s;
    keepalive 16;
}

upstream gestion_preprod_api {
    server 127.0.0.1:3001 max_fails=2 fail_timeout=10s;
    server 127.0.0.1:3003 max_fails=2 fail_timeout=10s;
    keepalive 4;
}

# Línea a agregar en cada `location` que use el upstream. Sólo reintenta en la
# otra copia cuando no se llegó a conectar: una venta nunca se manda dos veces.
#
#     proxy_next_upstream error timeout;
#     proxy_next_upstream_tries 2;
#
# nginx no reintenta pedidos POST/PATCH que ya salieron hacia la API (no son
# idempotentes) salvo que se agregue `non_idempotent`: no agregarlo.
