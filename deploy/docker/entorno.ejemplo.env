# Variables del compose (no son secretos). Copiar al servidor como
# /etc/gestion-api/docker.env (producción) o /etc/gestion-preprod/docker.env
# y pasarlo con --env-file. `actualizar.sh` reescribe GESTION_IMAGEN.

# Nombre del proyecto de compose: distinto por ambiente.
GESTION_PROYECTO=gestion
# Imagen construida por actualizar.sh: gestion-api:<id de versión>.
GESTION_IMAGEN=gestion-api:local
# Archivo de secretos del ambiente (el mismo que usa el servicio de systemd).
GESTION_ENTORNO=/etc/gestion-api/environment
# Puertos loopback de las dos copias. Producción 3000/3002, preprod 3001/3003.
GESTION_PUERTO_1=3000
GESTION_PUERTO_2=3002
# Usuario y grupo del servidor que pueden leer la clave fiscal (id ubuntu).
GESTION_UID=1000
GESTION_GID=1000
# Conexiones a PostgreSQL por proceso. La suma (2 x API + worker + consola)
# tiene que quedar por debajo de max_connections, contando preproducción.
GESTION_CONEXIONES_API=10
GESTION_CONEXIONES_WORKER=5
# Memoria máxima por contenedor.
GESTION_MEMORIA_API=1g
GESTION_MEMORIA_WORKER=2g
